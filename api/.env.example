# Sao chép thành .env và điền giá trị (không commit .env)
PORT=3001
# Kết nối TCP trực tiếp (SQL Server Express của máy này nghe cổng 1433, dịch vụ SQL Browser tắt)
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=ie402_green_space
DB_USER=sa
DB_PASSWORD=<mật khẩu>
# true cho SQL Server local (chứng chỉ tự ký); false cho Azure SQL
DB_TRUST_CERT=true
DB_POOL_MAX=10
# chuỗi ngẫu nhiên dài, ví dụ: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=<chuỗi bí mật>
JWT_EXPIRES=8h
CORS_ORIGIN=http://localhost:5173
