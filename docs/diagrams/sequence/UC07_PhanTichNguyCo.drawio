1;fillColor=#dae8fc;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="359.0" y="127.0" width="10.0" height="276.2" as="geometry" /></mxCell><mxCell id="UC07_PhanTichNguyCo-29" value="" style="html=1;fillColor=#dae8fc;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="557.0" y="188.8" width="10.0" height="152.8" as="geometry" /></mxCell><mxCell id="UC07_PhanTichNguyCo-30" value="" style="html=1;fillColor=#dae8fc;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="47.0" y="453.0" width="10.0" height="206.0" as="geometry" /></mxCell><mxCell id="UC07_PhanTichNguyCo-1" value="1. GET /phan-tich/&lt;br&gt;cay-nguy-co&lt;br&gt;(nạp sẵn)" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=15;verticalAlign=bottom;spacing=0;align=center;" vertex="1" parent="1"><mxGeometry x="218.5" y="79.2" width="136.4" height="51.8" as="geometry" /></mxCell><mxCell id="UC07_PhanTichNguyCo-2" value="" style="html=1;edgeStyle=none;endArrow=block;endSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="214.5" y="133.0" as="sourcePoint" /><mxPoint x="359.0" y="133.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="UC07_PhanTichNguyCo-3" value="2. EXEC sp_cay_&lt;br&gt;nguy_co_cong_trinh&lt;br&gt;(he_so = 1,5)" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=15;verticalAlign=bottom;spacing=0;align=center;" vertex="1" parent="1"><mxGeometry x="373.0" y="141.0" width="180.0" height="51.8" as="geometry" /></mxCell><mxCell id="UC07_PhanTichNguyCo-4" value="" style="html=1;edgeStyle=none;endArrow=block;endSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="369.0" y="194.8" as="sourcePoint" /><mxPoint x="557.0" y="194.8" as="targetPoint" /></mxGeometry></mxCell><mxCell id="UC07_PhanTichNguyCo-5" value="" style="html=1;edgeStyle=none;endArrow=block;endSize=6;rounded=0;" edge=