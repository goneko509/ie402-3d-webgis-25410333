05_3_SuaCay-5" value="[dời vị trí (tùy chọn),&lt;br&gt;nhấp tùy ý]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Times New Roman;fontSize=15;fontStyle=2;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="64.0" y="226.8" width="135.7" height="34.5" as="geometry" /></mxCell><mxCell id="UC05_3_SuaCay-6" value="3. Nhấp vị trí mới" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=15;verticalAlign=bottom;spacing=0;align=center;" vertex="1" parent="1"><mxGeometry x="61.0" y="263.2" width="143.7" height="17.2" as="geometry" /></mxCell><mxCell id="UC05_3_SuaCay-7" value="" style="html=1;edgeStyle=none;endArrow=block;endSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="57.0" y="282.5" as="sourcePoint" /><mxPoint x="208.7" y="282.5" as="targetPoint" /></mxGeometry></mxCell><mxCell id="UC05_3_SuaCay-8" value="" style="html=1;edgeStyle=none;endArrow=block;endSize=6;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="218.7" y="294.5" as="sourcePoint" /><mxPoint x="218.7" y="312.5" as="targetPoint" /><Array as="points"><mxPoint x="243.7" y="294.5" /><mxPoint x="243.7" y="312.5" /></Array></mxGeometry></mxCell><mxCell id="UC05_3_SuaCay-9" value="4. Kiểm tra trong khu, ngoài nền nhà,&lt;br&gt;cách cây khác ≥ 1 m; đặt ghim" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=15;verticalAlign=bottom;spacing=0;fillColor=#ffffff;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="249.7" y="289.5" width="342.3" height="34.5" as="geometry" /></mxCell><mxCell id="UC05_3_SuaCay-10" value="loop" style="shape=umlFrame;whiteSpace=wrap;html=1;width=44;height=22;fontStyle=1;fontFamily=Times New Roman;fontSize=15;fillColor=#ffffff;swimlaneFillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="6.0" y="202.8" width="588.0" height="134.2" as="geometry" /></mxCell><mxCell id="UC05_3_SuaCay-11" value="5. Sửa thuộc tính,&lt;br&gt;bấm Lưu" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=15;verticalAlign=bottom;spacing=0;align=center;" vertex="1" parent="1"><mxGeometry x="61.0" y="345.0" width="143.7" height="34.5" as="geometry" /></mxCell><mxCell id="UC05_3_SuaCay-12" value="" style="html=1;edgeStyle=none;endArrow=block;endSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="57.0" y="381.5" as="sourcePoint" /><mxPoint x="208.7" y="381.5" as="targetPoint" /></mxGeometry></mxCell><mxCell id="UC05_3_SuaCay-13" value="6. PUT /cay/{ma}&lt;br&gt;(thuộc tính, [x, y])" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=15;verticalAlign=bottom;spacing=0;align=center;" vertex="1" parent="1"><mxGeometry x="222.7" y="389.5" width="130.1" height="34.5" as="geometry" /></mxCell><mxCell id="UC05_3_SuaCay-14" value="" style="html=1;edgeStyle=none;endArrow=block;endSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="218.7" y="426.0" as="sourcePoint" /><mxPoint x="356.7" y="426.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="UC05_3_SuaCay-15" value="7. UPDATE cay_xanh" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=15;verticalAlign=bottom;spacing=0;align=center;" vertex="1" parent="1"><mxGeometry x="370.7" y="434.0" width="182.3" height="17.2" as="geometry" /></mxCell><mxCell id="UC05_3_SuaCay-16" value="" style="html=1;edgeStyle=none;endArrow=block;endSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="366.7" y="453.2" as="sourcePoint" /><mxPoint x="557.0" y="453.2" as="targetPoint" /></mxGeometry></mxCell><mxCell id="UC05_3_SuaCay-17" value="" style="html=1;edgeStyle=none;endArrow=block;endSize=6;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPo