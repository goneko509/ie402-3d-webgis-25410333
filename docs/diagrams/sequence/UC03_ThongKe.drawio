532.0" y="155.0" /><mxPoint x="532.0" y="173.0" /></Array></mxGeometry></mxCell><mxCell id="UC03_ThongKe-6" value="3. Hợp vùng tán&lt;br&gt;(STBuffer R, hợp),&lt;br&gt;diện tích, tỷ lệ che phủ,&lt;br&gt;thể tích tán,&lt;br&gt;mật độ theo khu" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=15;verticalAlign=bottom;spacing=0;fillColor=#ffffff;align=right;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="363.0" y="150.0" width="165.0" height="86.2" as="geometry" /></mxCell><mxCell id="UC03_ThongKe-7" value="4. Kết quả các khu&lt;br&gt;và toàn vùng" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=15;verticalAlign=bottom;spacing=0;align=center;" vertex="1" parent="1"><mxGeometry x="360.0" y="247.2" width="193.0" height="34.5" as="geometry" /></mxCell><mxCell id="UC03_ThongKe-8" value="" style="html=1;edgeStyle=none;endArrow=open;endSize=7;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="557.0" y="283.8" as="sourcePoint" /><mxPoint x="356.0" y="283.8" as="targetPoint" /></mxGeometry></mxCell><mxCell id="UC03_ThongKe-9" value="5. Số liệu&lt;br&gt;(lưu tại giao diện)" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=15;verticalAlign=bottom;spacing=0;align=center;" vertex="1" parent="1"><mxGeometry x="211.5" y="291.8" width="130.6" height="34.5" as="geometry" /></mxCell><mxCell id="UC03_ThongKe-10" value="" style="html=1;edgeStyle=none;endArrow=open;endSize=7;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="346.0" y="328.2" as="sourcePoint" /><mxPoint x="207.5" y="328.2" as="targetPoint" /></mxGeometry></mxCell><mxCell id="UC03_ThongKe-11" value="6. Chọn khu vực&lt;br&gt;(hoặc Toàn vùng&lt;br&gt;nghiên cứu)" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=15;verticalAlign=bottom;spacing=0;align=center;" vertex="1" parent="1"><mxGeometry x="61.0" y="336.2" width="132.5" height="51.8" as="geometry" /></mxCell><mxCell id="UC03_ThongKe-12" value="" style="html=1;edgeStyle=none;endArrow=block;endSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="57.0" y="390.0" as="sourcePoint" /><mxPoint x="197.5" y="390.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="UC03_ThongKe-13" value="" style="html=1;edgeStyle=none;endArrow=block;endSize=6;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="207.5" y="402.0" as="sourcePoint" /><mxPoint x="207.5" y="420.0" as="targetPoint" /><Array as="points"><mxPoint x="232.5" y="402.0" /><mxPoint x="232.5" y="420.0" /></Array></mxGeometry></mxCell><mxCell id="UC03_ThongKe-14" value="7. Căn khu vừa khít phần bản đồ trống, tô viền khu" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=15;verticalAlign=bottom;spacing=0;fillColor=#ffffff;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="238.5" y="397.0" width="353.5" height="17.2" as="geometry" /></mxCell><mxCell id="UC03_ThongKe-15" value="" style="html=1;edgeStyle=none;endArrow=block;endSize=6;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="207.5" y="435.0" as="sourcePoint" /><mxPoint x="207.5" y="453.0" as="targetPoint" /><Array as="points"><mxPoint x="232.5" y="435.0" /><mxPoint x="232.5" y="453.0" /></Array></mxGeometry></mxCell><mxCell id="UC03_ThongKe-16" value="8. Thống kê cây xanh theo loài, tình trạng (%)&lt;br&gt;từ dữ liệu cây đã tải" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=15;verticalAlign=bottom;spacing=0;fillColor=#ffffff;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="238.5" y="430.0" width="353.5" height="34.5" as="geometry" /></mxCell><mxCell id="UC03_ThongKe-17" value="9. KPI, biểu đồ,&lt;br&gt;thống kê cây xanh" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=15;verticalAlign=bottom;spacing=0;align=center;" vertex="1" parent="1"><mxGeometry x="61.0" y="475.5" width="132.5" height="34.5" as="geometry" /></mxCell><mxCell id="UC03_ThongKe-18" value="" style="html=1;edgeStyle=none;endArrow=open;endSize=7;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="197.5" y="512.0" as="sourcePoint" /><mxPoint x="57.0" y="512.0" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>