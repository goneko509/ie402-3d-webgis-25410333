<mxfile host="Electron" pages="3">
  <diagram name="Page-1" id="9LuqM5YtivSR9RP0aL0p">
    <mxGraphModel dx="1814" dy="2301" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="bg" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=none;fillColor=#FFFFFF;fontSize=19;align=left;" value="" vertex="1">
          <mxGeometry height="650" width="1500" as="geometry" />
        </mxCell>
        <mxCell id="box_L1_title" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=24;fontStyle=1;fontColor=#1B5E20;align=center;" value="Dữ liệu và&lt;br&gt;cảnh 3D" vertex="1">
          <mxGeometry height="195" width="195" x="20" y="65" as="geometry" />
        </mxCell>
        <mxCell id="box_L1_body" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F9FBF9;strokeColor=#2E7D32;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=21;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;• Dữ liệu và cảnh 3D:&lt;/b&gt; dữ liệu lấy trực tiếp từ CSDL qua REST API. Cảnh 3D hiển thị ngay trong hệ tọa độ VN-2000 / UTM 48N. Mỗi cây được dựng theo mô hình rút gọn: thân trụ có đường kính bằng DBH, cao &lt;i&gt;(1 - k)H&lt;/i&gt;; tán dạng cầu co giãn rộng &lt;i&gt;2R&lt;/i&gt;, cao &lt;i&gt;kH&lt;/i&gt;, màu theo loài. Lớp Vùng che phủ là hình chiếu tán xuống mặt đất (hình tròn bán kính &lt;i&gt;R&lt;/i&gt;), cùng định nghĩa với phép tính che phủ; lớp ảnh vệ tinh lấy từ dịch vụ Esri World Imagery." vertex="1">
          <mxGeometry height="195" width="520" x="220" y="65" as="geometry" />
        </mxCell>
        <mxCell id="box_L2_title" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=24;fontStyle=1;fontColor=#E65100;align=center;" value="Tra cứu, lọc và&lt;br&gt;xem theo nhóm" vertex="1">
          <mxGeometry height="155" width="195" x="20" y="272" as="geometry" />
        </mxCell>
        <mxCell id="box_L2_body" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFDF7;strokeColor=#F57F17;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=21;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;• Tra cứu, lọc và xem theo nhóm:&lt;/b&gt; tìm theo mã hoặc loài; Lọc cây theo thuộc tính; xem theo loài và tình trạng (song song với nhau), bản đồ tự tập trung vào khu có nhiều cây thỏa điều kiện nhất; hộp bối cảnh luôn cho biết khu, loài, tình trạng đang xem." vertex="1">
          <mxGeometry height="155" width="520" x="220" y="272" as="geometry" />
        </mxCell>
        <mxCell id="box_L3_title" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00695C;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=24;fontStyle=1;fontColor=#004D40;align=center;" value="Thống kê&lt;br&gt;che phủ" vertex="1">
          <mxGeometry height="125" width="195" x="20" y="439" as="geometry" />
        </mxCell>
        <mxCell id="box_L3_body" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4FBF9;strokeColor=#00695C;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=21;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;• Thống kê che phủ:&lt;/b&gt; số liệu do thủ tục &lt;b&gt;sp_thong_ke_che_phu&lt;/b&gt; tính trong CSDL, cho toàn vùng hoặc từng khu, được đối chiếu với QGIS ở mục Kiểm định hệ thống." vertex="1">
          <mxGeometry height="125" width="520" x="220" y="439" as="geometry" />
        </mxCell>
        <mxCell id="box_R1_title" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=24;fontStyle=1;fontColor=#B71C1C;align=center;" value="Phân tích&amp;nbsp;&lt;div&gt;nguy cơ ngã đổ&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="195" x="760" y="65" as="geometry" />
        </mxCell>
        <mxCell id="box_R1_body" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF9FA;strokeColor=#C62828;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=21;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;• Phân tích nguy cơ ngã đổ:&lt;/b&gt; vùng ngã đổ &lt;i&gt;1,5 × H&lt;/i&gt;, mức nguy hiểm theo vùng mục tiêu ISA; kết quả trình bày ở mục Kết quả phân tích nguy cơ ngã đổ." vertex="1">
          <mxGeometry height="110" width="520" x="960" y="65" as="geometry" />
        </mxCell>
        <mxCell id="box_R2_title" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=24;fontStyle=1;fontColor=#E65100;align=center;" value="Quản lý cây&lt;br&gt;(Kiểm tra 2 lớp)" vertex="1">
          <mxGeometry height="240" width="195" x="760" y="187" as="geometry" />
        </mxCell>
        <mxCell id="box_R2_body" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFBF5;strokeColor=#EF6C00;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=21;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;• Quản lý cây:&lt;/b&gt; Người quản lý khu thêm, nhân bản, sửa (kể cả dời vị trí) và xóa cây trong khu được phân công. Vị trí được kiểm tra hai lớp: giao diện chặn ngay khi nhấp ngoài khu, trong nền tòa nhà hoặc cách cây khác dưới 1 m (Hình 33d); trigger trong CSDL chặn lại một lần nữa (lỗi 50104, 50102, 50103) nên không thể ghi sai kể cả khi gọi API trực tiếp. Mọi thay đổi được ghi vào nhật ký kèm giá trị cũ, giá trị mới và người thao tác; cảnh 3D và thống kê cập nhật ngay." vertex="1">
          <mxGeometry height="240" width="520" x="960" y="187" as="geometry" />
        </mxCell>
        <mxCell id="box_R3_title" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=24;fontStyle=1;fontColor=#4A148C;align=center;" value="Quản trị&lt;br&gt;hệ thống" vertex="1">
          <mxGeometry height="125" width="195" x="760" y="439" as="geometry" />
        </mxCell>
        <mxCell id="box_R3_body" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCF8FD;strokeColor=#6A1B9A;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=21;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;• Quản trị hệ thống:&lt;/b&gt; tài khoản kỹ thuật không bị giới hạn khu, xem trước rồi khôi phục dữ liệu mặc định (hoàn tác thay đổi của người quản lý, giữ thay đổi của admin) và hoàn tác từng thay đổi theo nhật ký." vertex="1">
          <mxGeometry height="125" width="520" x="960" y="439" as="geometry" />
        </mxCell>
        <mxCell id="bottom_bar" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=19;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=15;spacingRight=15;" value="&lt;b&gt;Hiện thực &amp;amp; Triển khai:&lt;/b&gt; Ứng dụng WebGIS hiện thực kiến trúc 3 lớp ở Chương 3 và đang chạy trên &lt;b&gt;Microsoft Azure&lt;/b&gt; (bản triển khai ngày 09/10/2026, CSDL trên Azure đã được cập nhật đủ các script đến &lt;b&gt;db/25&lt;/b&gt;). Giao diện theo đúng thiết kế ở Chương 3 (Hình 23, Bảng 35). Cả &lt;b&gt;15 use case&lt;/b&gt; ở Chương 2 đều đã được hiện thực (Bảng 37)." vertex="1">
          <mxGeometry height="58" width="1460" x="20" y="577" as="geometry" />
        </mxCell>
        <mxCell id="hdr_L1" parent="1" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=24;fontStyle=1;fontColor=#111111;align=center;" value="Chức năng&amp;nbsp;&lt;div&gt;&amp;amp; Hiện thực&lt;/div&gt;" vertex="1">
          <mxGeometry height="58" width="195" x="20" y="-3" as="geometry" />
        </mxCell>
        <mxCell id="hdr_L2" parent="1" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=#0D47A1;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=24;fontStyle=1;fontColor=#FFFFFF;align=center;" value="Chi tiết kỹ thuật &amp;amp; Dữ liệu" vertex="1">
          <mxGeometry height="58" width="520" x="220" y="-3" as="geometry" />
        </mxCell>
        <mxCell id="hdr_R1" parent="1" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=24;fontStyle=1;fontColor=#111111;align=center;" value="Chức năng&amp;nbsp;&lt;div&gt;&amp;amp; Hiện thực&lt;/div&gt;" vertex="1">
          <mxGeometry height="58" width="195" x="760" y="-3" as="geometry" />
        </mxCell>
        <mxCell id="hdr_R2" parent="1" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=#0D47A1;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=24;fontStyle=1;fontColor=#FFFFFF;align=center;" value="Chi tiết kỹ thuật &amp;amp; Dữ liệu" vertex="1">
          <mxGeometry height="58" width="520" x="960" y="-3" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
