x 6px;border-bottom:1px solid #BDBDBD;&quot;&gt;ngay_trong&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #BDBDBD;color:#000000;&quot;&gt;Ngày trồng&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #BDBDBD;&quot;&gt;tinh_trang&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #BDBDBD;color:#000000;&quot;&gt;Tình trạng&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #BDBDBD;&quot;&gt;ngay_cap_nhat&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #BDBDBD;color:#000000;&quot;&gt;Ngày cập nhật (cột kỹ thuật)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
