        <mxCell id="m21" parent="1" style="fontFamily=Times New Roman;text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=17;fontColor=#000000;" value="&lt;b&gt;c) Dẫn xuất từ N0, H, R, DBH&lt;/b&gt; (k = 0,75)" vertex="1">
